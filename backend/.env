# ChainShield Environment Variables
# Copy this file to .env and update with your values

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/chainshield

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE=7d

# ML Service Configuration
# Option 1: Local Python service (runs on your PC) - RECOMMENDED
ML_SERVICE_URL=http://localhost:5001

# Option 2: Use free ML API (Hugging Face - not recommended for fraud detection)
# USE_FREE_ML_API=true
# FREE_ML_API_URL=https://api-inference.huggingface.co/models/your-model
# HUGGINGFACE_API_KEY=your_free_api_key

# Option 3: Disable ML (use rule-based only)
# ML_SERVICE_URL=none

# Graph Analytics Service Configuration
# Local Python service (runs on your PC) - RECOMMENDED
GRAPH_SERVICE_URL=http://localhost:5002

# Option: Disable graph analytics
# GRAPH_SERVICE_URL=none

# Blockchain Configuration
# Option 1: Disabled (hash-based only) - RECOMMENDED FOR TESTING
BLOCKCHAIN_RPC_URL=http://ganache:8545

# Option 2: Free Public RPC (NO API KEY NEEDED!)
# BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
# USE_FREE_BLOCKCHAIN_API=true

# Option 3: Free tier APIs (requires free account)
# Infura (free tier: 100k requests/day)
# BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Alchemy (free tier: 300M compute units/month)
# BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Option 4: Local Ganache (requires installation)
# BLOCKCHAIN_RPC_URL=http://localhost:8545

# Contract address (deployed on Ganache - DO NOT CHANGE)
CONTRACT_ADDRESS=0x600b5D43D51e9D7e89C59cA3abcf2f71de2DC865

# Blockchain account (only needed for smart contract transactions)
BLOCKCHAIN_ACCOUNT=0x90F8bf6A479f320ead074411a4B0e7944Ea8c9C1
BLOCKCHAIN_PRIVATE_KEY=0x6b8c77a145fa0aa993d3aaf997244ed29888a56f342621bbe5e0adb0574fb6c6

# Redis Configuration (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
