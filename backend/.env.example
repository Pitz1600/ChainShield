# ============================================
# ChainShield Environment Configuration
# ============================================
# Copy this file to .env and configure with your values

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# DATABASE CONFIGURATION
# ============================================
MONGODB_URI=mongodb://localhost:27017/chainshield

# MongoDB Authentication (used by docker-compose)
MONGO_ROOT_USERNAME=chainshield_admin
MONGO_ROOT_PASSWORD=changeme_in_production

# MongoDB TLS (enable for production)
# MONGODB_TLS=true
# MONGODB_TLS_CA_FILE=/path/to/ca.pem
# MONGODB_TLS_ALLOW_INVALID=false

# Encrypted Backup Key (generate with: openssl rand -hex 32)
# BACKUP_ENCRYPTION_KEY=your-32-byte-hex-key

# ============================================
# SECURITY CONFIGURATION
# ============================================
# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-please-use-strong-random-string
JWT_EXPIRE=7d

# TOTP 2FA Encryption Key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# WARNING: If this key is lost, all users must re-setup 2FA
TOTP_ENCRYPTION_KEY=

# ============================================
# EMAIL CONFIGURATION (OTP & Notifications)
# ============================================
# Development Mode: Leave all SMTP variables commented
# - OTP codes will be printed to console/terminal
# - Perfect for testing without email setup

# Production Mode: Uncomment ONE of the options below

# --- Option 1: Gmail (Recommended for personal/small projects) ---
# 1. Enable 2FA on your Google account
# 2. Generate app password: https://myaccount.google.com/apppasswords
# 3. Uncomment these lines and add your credentials:

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
# EMAIL_FROM=your-email@gmail.com
# EMAIL_FROM_NAME=ChainShield

# --- Option 2: Mailtrap (Recommended for testing) ---
# Free email testing service - catches all emails
# Sign up: https://mailtrap.io

# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=your-mailtrap-username
# SMTP_PASS=your-mailtrap-password
# EMAIL_FROM=noreply@chainshield.local
# EMAIL_FROM_NAME=ChainShield

# --- Option 3: SendGrid (Recommended for production) ---
# Free tier: 100 emails/day
# Sign up: https://sendgrid.com

# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_FROM_NAME=ChainShield

# --- Option 4: Custom SMTP Server ---
# SMTP_HOST=smtp.yourserver.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-username
# SMTP_PASS=your-password
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_FROM_NAME=ChainShield

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:5173

# ============================================
# ML SERVICE CONFIGURATION
# ============================================
# Option 1: Local Python service (recommended)
ML_SERVICE_URL=http://localhost:5001

# Option 2: Use free ML API (not recommended for production)
# USE_FREE_ML_API=true
# FREE_ML_API_URL=https://api-inference.huggingface.co/models/your-model
# HUGGINGFACE_API_KEY=your_free_api_key

# Option 3: Disable ML (use rule-based detection only)
# ML_SERVICE_URL=none

# ============================================
# GRAPH ANALYTICS SERVICE CONFIGURATION
# ============================================
# Local Python service (recommended)
GRAPH_SERVICE_URL=http://localhost:5002

# Disable graph analytics
# GRAPH_SERVICE_URL=none

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================
# Option 1: Local Ganache (via Docker - recommended for development)
BLOCKCHAIN_RPC_URL=http://ganache:8545

# Option 2: Free Public RPC (no API key needed)
# BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
# USE_FREE_BLOCKCHAIN_API=true

# Option 3: Infura (free tier: 100k requests/day)
# BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Option 4: Alchemy (free tier: 300M compute units/month)
# BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Contract Configuration (deployed on Ganache)
CONTRACT_ADDRESS=
BLOCKCHAIN_ACCOUNT=
BLOCKCHAIN_PRIVATE_KEY=

# ============================================
# REDIS CONFIGURATION (Optional - for caching)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# NOTES
# ============================================
# - For development: Keep SMTP commented to see OTP in console
# - For production: Configure SMTP and use strong JWT_SECRET
# - Change default blockchain keys in production
# - Never commit .env file to version control
