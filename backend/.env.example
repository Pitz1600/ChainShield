# Backend Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/chainshield
JWT_SECRET=your_jwt_secret_here

# ML Service Configuration
ML_SERVICE_URL=http://localhost:5001

# Graph Service Configuration
GRAPH_SERVICE_URL=http://localhost:5002

# Blockchain Configuration
# Set to 'none' to disable blockchain features for testing
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=your_contract_address_here

# Blockchain Account (Optional - for recording hashes)
BLOCKCHAIN_ACCOUNT=
BLOCKCHAIN_PRIVATE_KEY=

# Economic Data (PSA Simulation)
INFLATION_RATE=0.08
